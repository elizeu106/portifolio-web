        line-height: 1.7;
        
        background-color: #6b21a8;
    }

    
    .historia-header {
        text-align: center;
        margin-bottom: 30px;
        padding: 20px;
        background: #ffffff;
        color: #000000;
        border-radius: 12px;
        border: 1px solid #dddddd;
    }

        .historia-header h1,
        .historia-header h2,
        .subtitulo {
            color: #000000;
        }

    .card {
        background-color: #ffffff;
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 12px;
        border: 1px solid #dddddd;
    }

        .card h3 {
            color: #000000;
            margin-bottom: 10px;
            border-left: 4px solid #000000;
            padding-left: 10px;
        }

        .card p {
            margin-bottom: 12px;
            text-align: justify;
            color: #000000;
        }

    .destaque {
        background-color: #ffffff;
        border-left: 6px solid #000000;
    }
</style>

